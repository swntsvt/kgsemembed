<?xml version="1.0"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:ex="http://example.org/source/">

  <rdf:Description rdf:about="http://example.org/source/EntityA">
    <rdfs:label xml:lang="en">Entity A</rdfs:label>
    <ex:relatedTo rdf:resource="http://example.org/source/EntityB"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://example.org/source/EntityB">
    <rdfs:label xml:lang="en">Entity B</rdfs:label>
  </rdf:Description>
</rdf:RDF>
